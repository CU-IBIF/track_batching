# Jython 2.7 script run by Fiji in headless mode:
#   ImageJ-win64.exe --headless --console --run trackmate_batch.py
# The path to the job manifest (JSON) is passed in TRACKBATCH_MANIFEST.
# Generated by trackbatch - do not edit; changes are overwritten on each run.
from __future__ import print_function

import codecs
import json
import os
import sys
import time
import traceback

from java.io import File
from java.lang import Boolean, Class, Double, Integer, System, Throwable
from java.util import HashMap

from ij import IJ

from fiji.plugin.trackmate import Model, Settings, TrackMate, Logger
from fiji.plugin.trackmate.features import FeatureFilter
from fiji.plugin.trackmate.io import TmXmlWriter
from fiji.plugin.trackmate.providers import DetectorProvider, TrackerProvider


def say(msg):
    print("[trackbatch] " + msg)
    sys.stdout.flush()


def write_json(path, obj):
    fh = codecs.open(path, "w", "utf-8")
    try:
        fh.write(json.dumps(obj, indent=2))
    finally:
        fh.close()


def to_java(value, default):
    """Convert a JSON value to the Java type TrackMate expects for this key."""
    if value is None:
        return None
    if isinstance(value, dict):
        m = HashMap()
        for k, v in value.items():
            m.put(k, Double(float(v)))
        return m
    if isinstance(default, bool):
        if isinstance(value, basestring):
            return Boolean(value.lower() == "true")
        return Boolean(bool(value))
    if isinstance(default, float):
        return Double(float(value))
    if isinstance(default, (int, long)):
        return Integer(int(value))
    if isinstance(value, bool):
        return Boolean(value)
    if isinstance(value, float):
        return Double(value)
    if isinstance(value, (int, long)):
        return Integer(int(value))
    return value


def build_map(factory, user, name_key):
    """Start from the factory defaults, then apply the user's values with matching types."""
    defaults = factory.getDefaultSettings()
    result = HashMap(defaults)
    for key, value in user.items():
        if key == name_key:
            continue
        if not defaults.containsKey(key):
            say("WARNING: %s does not know setting %s - ignored" % (factory.getKey(), key))
            continue
        result.put(key, to_java(value, defaults.get(key)))
    return result


def open_image(path, opts):
    imp = None
    lower = path.lower()
    if lower.endswith(".tif") or lower.endswith(".tiff"):
        imp = IJ.openImage(path)
    if imp is None:
        from loci.plugins import BF
        series = int(opts.get("series") or 0)
        if series > 0:
            # loci.plugins.in can't be imported by name ("in" is a keyword), so use reflection.
            io = Class.forName("loci.plugins.in.ImporterOptions").newInstance()
            io.setId(path)
            io.setSeriesOn(series, True)
            imps = BF.openImagePlus(io)
        else:
            imps = BF.openImagePlus(path)
        imp = imps[0] if imps else None
    if imp is None:
        raise IOError("Could not open image " + path)
    swap = opts.get("swap_z_t", "auto")
    dims = imp.getDimensions()  # w, h, c, z, t
    if swap is True or (swap == "auto" and dims[3] > 1 and dims[4] == 1):
        imp.setDimensions(dims[2], dims[4], dims[3])
        say("Swapped Z and T (%d slices -> %d frames)" % (dims[3], dims[3]))
    return imp


def apply_calibration(imp, cal_opts):
    cal = imp.getCalibration()
    if cal_opts.get("pixel_width"):
        cal.pixelWidth = float(cal_opts["pixel_width"])
    if cal_opts.get("pixel_height") or cal_opts.get("pixel_width"):
        cal.pixelHeight = float(cal_opts.get("pixel_height") or cal_opts["pixel_width"])
    if cal_opts.get("voxel_depth"):
        cal.pixelDepth = float(cal_opts["voxel_depth"])
    if cal_opts.get("frame_interval"):
        cal.frameInterval = float(cal_opts["frame_interval"])
    if cal_opts.get("space_unit"):
        cal.setUnit(cal_opts["space_unit"])
    if cal_opts.get("time_unit"):
        cal.setTimeUnit(cal_opts["time_unit"])


def make_settings(imp, params):
    try:
        settings = Settings(imp)
    except Exception:  # TrackMate < 7
        settings = Settings()
        settings.setFrom(imp)

    det = params["detector"]
    det_factory = DetectorProvider().getFactory(det["DETECTOR_NAME"])
    if det_factory is None:
        raise ValueError("Unknown TrackMate detector: %s (is its plugin installed?)" % det["DETECTOR_NAME"])
    settings.detectorFactory = det_factory
    settings.detectorSettings = build_map(det_factory, det, "DETECTOR_NAME")

    trk = params["tracker"]
    trk_factory = TrackerProvider().getFactory(trk["TRACKER_NAME"])
    if trk_factory is None:
        raise ValueError("Unknown TrackMate tracker: %s (is its plugin installed?)" % trk["TRACKER_NAME"])
    settings.trackerFactory = trk_factory
    settings.trackerSettings = build_map(trk_factory, trk, "TRACKER_NAME")

    if not det_factory.checkSettings(settings.detectorSettings):
        raise ValueError("Invalid detector settings: " + str(det_factory.getErrorMessage()))
    if not trk_factory.checkSettingsValidity(settings.trackerSettings):
        raise ValueError("Invalid tracker settings: " + str(trk_factory.getErrorMessage()))

    settings.addAllAnalyzers()

    init = params.get("initial_spot_filter")
    if init:
        settings.initialSpotFilterValue = Double(float(init["value"]))
    for f in params.get("spot_filters") or []:
        settings.addSpotFilter(FeatureFilter(f["feature"], float(f["value"]), bool(f.get("is_above", True))))
    for f in params.get("track_filters") or []:
        settings.addTrackFilter(FeatureFilter(f["feature"], float(f["value"]), bool(f.get("is_above", True))))
    return settings


def fmt(v):
    if v is None:
        return ""
    return str(v)


def write_csv(path, header, rows):
    fh = codecs.open(path, "w", "utf-8")
    try:
        fh.write(",".join(header) + "\n")
        for row in rows:
            fh.write(",".join(fmt(v) for v in row) + "\n")
    finally:
        fh.close()


def export_csvs(model, out_dir, export):
    fm = model.getFeatureModel()
    tm = model.getTrackModel()
    stats = {}

    spots = list(model.getSpots().iterable(True))
    stats["n_spots"] = len(spots)
    if export.get("spots_csv", True):
        names = list(fm.getSpotFeatures())
        rows = []
        for s in spots:
            tid = tm.trackIDOf(s)
            rows.append([s.ID(), tid] + [s.getFeature(n) for n in names])
        write_csv(os.path.join(out_dir, "spots.csv"), ["SPOT_ID", "TRACK_ID"] + names, rows)

    track_ids = list(tm.trackIDs(True))
    stats["n_tracks"] = len(track_ids)
    if export.get("edges_csv", True):
        names = list(fm.getEdgeFeatures())
        rows = []
        for tid in track_ids:
            for e in tm.trackEdges(tid):
                rows.append([tid, tm.getEdgeSource(e).ID(), tm.getEdgeTarget(e).ID()] + [fm.getEdgeFeature(e, n) for n in names])
        write_csv(os.path.join(out_dir, "edges.csv"), ["TRACK_ID", "SOURCE_SPOT_ID", "TARGET_SPOT_ID"] + names, rows)

    if export.get("tracks_csv", True):
        names = list(fm.getTrackFeatures())
        rows = [[tid] + [fm.getTrackFeature(tid, n) for n in names] for tid in track_ids]
        write_csv(os.path.join(out_dir, "tracks.csv"), ["TRACK_ID"] + names, rows)
    return stats


def run_job(job, params):
    out_dir = job["output_dir"]
    if not os.path.isdir(out_dir):
        os.makedirs(out_dir)
    t0 = time.time()
    imp = open_image(job["image"], params.get("image") or {})
    apply_calibration(imp, params.get("calibration") or {})

    model = Model()
    model.setLogger(Logger.IJ_LOGGER)
    settings = make_settings(imp, params)
    trackmate = TrackMate(model, settings)
    threads = int(params.get("threads") or 0)
    if threads > 0:
        trackmate.setNumThreads(threads)
    if not trackmate.checkInput():
        raise RuntimeError("TrackMate input check failed: " + str(trackmate.getErrorMessage()))
    if not trackmate.process():
        raise RuntimeError("TrackMate processing failed: " + str(trackmate.getErrorMessage()))

    export = params.get("export") or {}
    if export.get("xml", True):
        writer = TmXmlWriter(File(os.path.join(out_dir, "trackmate.xml")))
        writer.appendModel(model)
        writer.appendSettings(settings)
        writer.writeToFile()
    stats = export_csvs(model, out_dir, export)
    stats["seconds"] = round(time.time() - t0, 1)
    imp.close()
    return stats


def main():
    manifest_path = os.environ.get("TRACKBATCH_MANIFEST") or System.getenv("TRACKBATCH_MANIFEST")
    if not manifest_path:
        say("ERROR: TRACKBATCH_MANIFEST is not set")
        return
    fh = codecs.open(manifest_path, "r", "utf-8")
    try:
        manifest = json.loads(fh.read())
    finally:
        fh.close()
    params = manifest["params"]
    jobs = manifest["jobs"]
    for i, job in enumerate(jobs):
        say("JOB %d START %s (%d/%d)" % (job["id"], job["image"], i + 1, len(jobs)))
        status = {"status": "failed", "image": job["image"], "error": "", "stats": {}}
        try:
            status["stats"] = run_job(job, params)
            status["status"] = "ok"
        except Exception as exc:  # Python-side errors
            status["error"] = "%s: %s" % (type(exc).__name__, exc)
            traceback.print_exc()
        except Throwable as exc:  # Java exceptions
            status["error"] = "Java: %s" % exc
        write_json(os.path.join(job["output_dir"], "trackbatch_status.json"), status)
        if status["status"] == "ok":
            say("JOB %d OK spots=%s tracks=%s" % (job["id"], status["stats"].get("n_spots"), status["stats"].get("n_tracks")))
        else:
            say("JOB %d FAILED %s" % (job["id"], status["error"]))

main()
System.exit(0)
